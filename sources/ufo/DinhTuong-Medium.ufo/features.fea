feature tnum {
  sub zero by zero.tf;
  sub one by one.tf;
  sub two by two.tf;
  sub three by three.tf;
  sub four by four.tf;
  sub five by five.tf;
  sub six by six.tf;
  sub seven by seven.tf;
  sub eight by eight.tf;
  sub nine by nine.tf;
} tnum;

