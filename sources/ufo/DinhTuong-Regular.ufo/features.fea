languagesystem DFLT dflt;
languagesystem latn dflt;
languagesystem latn VIT;

feature tnum {
  sub zero by zero.tf;
  sub one by one.tf;
  sub two by two.tf;
  sub three by three.tf;
  sub four by four.tf;
  sub five by five.tf;
  sub six by six.tf;
  sub seven by seven.tf;
  sub eight by eight.tf;
  sub nine by nine.tf;
} tnum;

# SD1 soft-dotted (soft_dotted.py) begin
@SD_BASE = [i j iogonek uni1ECB];
@SD_TOP = [gravecomb acutecomb uni0302 tildecomb uni0304 uni0306 uni0307 uni0308 hookabovecomb uni030A uni030B uni030C];
@SD_LOW = [uni031B dotbelowcomb uni0326 uni0327 uni0328];
lookup SD_DOTLESS {
  sub i by dotlessi;
  sub j by uni0237;
  sub iogonek by iogonek.dotless;
  sub uni1ECB by uni1ECB.dotless;
} SD_DOTLESS;
# SD1 soft-dotted end
